---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import { getPostsByCategory, getAllCategories } from "../../../utils/content";

export async function getStaticPaths() {
  const categories = await getAllCategories();
  return categories.map((c) => ({ params: { category: c.name } }));
}

const { category } = Astro.params;
const posts = await getPostsByCategory(category);
---

<BaseLayout title={`分类：${category}`}>
  <header class="mb-8">
    <h1 class="text-2xl font-bold sm:text-3xl">分类：{category}</h1>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">共 {posts.length} 篇文章</p>
  </header>
  {posts.length === 0 ? (
    <p class="py-12 text-center text-gray-400 dark:text-gray-500">该分类下暂无文章</p>
  ) : (
    <PostList posts={posts} />
  )}
</BaseLayout>
