---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TagCloud from "../../../components/TagCloud.astro";
import { getAllTags } from "../../../utils/content";

const tags = await getAllTags();
---

<BaseLayout title="标签">
  <header class="mb-8">
    <h1 class="text-2xl font-bold sm:text-3xl">标签</h1>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">共 {tags.length} 个标签</p>
  </header>
  <TagCloud tags={tags} />
</BaseLayout>
