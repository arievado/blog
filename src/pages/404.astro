---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — 页面未找到">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-6xl font-bold text-gray-300 dark:text-gray-700">404</h1>
    <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">页面不存在</p>
    <a
      href="/"
      class="mt-6 rounded-md bg-accent px-4 py-2 text-sm text-white hover:opacity-90 no-underline"
    >
      返回首页
    </a>
  </div>
</BaseLayout>
