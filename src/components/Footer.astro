---
import { SITE_AUTHOR, GITHUB_USERNAME } from "../utils/constants";
---

<footer class="border-t border-gray-200 py-8 dark:border-gray-800">
  <div class="mx-auto max-w-4xl px-4 text-center text-sm text-gray-500 dark:text-gray-500 sm:px-6">
    <p>&copy; {new Date().getFullYear()} {SITE_AUTHOR}. Built with Astro.</p>
    <p class="mt-1">
      <a
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-gray-700 dark:hover:text-gray-300"
      >
        GitHub
      </a>
    </p>
  </div>
</footer>
