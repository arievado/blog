---
import { SITE_AVATAR, SITE_TITLE } from "../utils/constants";
import { ThemeToggle } from "../components/ThemeToggle";

const base = import.meta.env.BASE_URL;
const avatarSrc = `${base}/${SITE_AVATAR.replace(/^\//, "")}`;

const topLevelItems = [
  { label: "首页", href: `${base}/`, icon: `<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` },
  { label: "关于", href: `${base}/about/`, icon: `<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>` },
];

const dropdownItems = [
  {
    label: "分类",
    href: `${base}/blog/category/`,
    icon: `<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    label: "标签",
    href: `${base}/blog/tag/`,
    icon: `<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>`,
  },
  {
    label: "归档",
    href: `${base}/archive/`,
    icon: `<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  },
];
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur dark:border-gray-800 dark:bg-gray-950/80">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3 sm:px-6">
    <a href={`${base}/`} class="flex items-center gap-2 text-lg font-bold text-gray-900 dark:text-white no-underline">
      <img
        id="header-avatar"
        src={avatarSrc}
        alt={SITE_TITLE}
        data-placeholder={SITE_TITLE.charAt(0)}
        class="h-8 w-8 rounded-full object-cover"
        width="32"
        height="32"
      />
      {SITE_TITLE}
    </a>

    <!-- Desktop navigation (hidden on mobile) -->
    <ul class="hidden items-center gap-1 sm:gap-2 md:flex">
      {topLevelItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          >
            <Fragment set:html={item.icon} />
            {item.label}
          </a>
        </li>
      ))}

      <!-- 文章 dropdown -->
      <li class="relative">
        <button
          id="dropdown-toggle"
          class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          aria-expanded="false"
        >
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          文章
          <svg id="dropdown-arrow" class="h-3.5 w-3.5 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div
          id="dropdown-panel"
          class="absolute left-0 top-full z-50 mt-1 hidden min-w-[160px] rounded-lg border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-700 dark:bg-gray-900"
        >
          {dropdownItems.map((item) => (
            <a
              href={item.href}
              class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
            >
              <Fragment set:html={item.icon} />
              {item.label}
            </a>
          ))}
        </div>
      </li>
    </ul>

    <!-- ThemeToggle + hamburger -->
    <div class="flex items-center gap-1">
      <ThemeToggle client:load />
      <button
        id="hamburger-btn"
        class="hamburger rounded-md p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 md:hidden"
        aria-label="菜单"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu dropdown -->
  <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white px-4 pb-4 dark:border-gray-800 dark:bg-gray-950 md:hidden">
    <ul class="flex flex-col gap-1 pt-2">
      {topLevelItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          >
            <Fragment set:html={item.icon} />
            {item.label}
          </a>
        </li>
      ))}

      <!-- 文章 (expandable group) -->
      <li>
        <button
          id="mobile-articles-toggle"
          class="flex w-full items-center justify-between rounded-md px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
        >
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>文章</span>
          <svg id="mobile-articles-arrow" class="h-3.5 w-3.5 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <ul id="mobile-articles-submenu" class="hidden ml-4 flex flex-col gap-1 pt-1">
          {dropdownItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
              >
                <Fragment set:html={item.icon} />
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  // Desktop dropdown
  const dropdownToggle = document.getElementById("dropdown-toggle");
  const dropdownPanel = document.getElementById("dropdown-panel");
  const dropdownArrow = document.getElementById("dropdown-arrow");
  let dropdownOpen = false;

  dropdownToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    dropdownOpen = !dropdownOpen;
    dropdownPanel?.classList.toggle("hidden", !dropdownOpen);
    dropdownToggle.setAttribute("aria-expanded", String(dropdownOpen));
    if (dropdownArrow) {
      dropdownArrow.style.transform = dropdownOpen ? "rotate(180deg)" : "";
    }
  });

  dropdownPanel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      dropdownOpen = false;
      dropdownPanel?.classList.add("hidden");
      dropdownToggle.setAttribute("aria-expanded", "false");
      if (dropdownArrow) dropdownArrow.style.transform = "";
    });
  });

  document.addEventListener("click", (e) => {
    if (dropdownOpen && e.target && !dropdownToggle?.contains(e.target) && !dropdownPanel?.contains(e.target)) {
      dropdownOpen = false;
      dropdownPanel?.classList.add("hidden");
      dropdownToggle.setAttribute("aria-expanded", "false");
      if (dropdownArrow) dropdownArrow.style.transform = "";
    }
  });

  // Mobile hamburger menu
  const hamburger = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  let menuOpen = false;

  hamburger?.addEventListener("click", () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle("hidden", !menuOpen);
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menuOpen = false;
      mobileMenu?.classList.add("hidden");
    });
  });

  document.addEventListener("click", (e) => {
    if (menuOpen && e.target && !hamburger?.contains(e.target) && !mobileMenu?.contains(e.target)) {
      menuOpen = false;
      mobileMenu?.classList.add("hidden");
    }
  });

  // Mobile articles submenu
  const mobileArticlesToggle = document.getElementById("mobile-articles-toggle");
  const mobileArticlesSubmenu = document.getElementById("mobile-articles-submenu");
  const mobileArticlesArrow = document.getElementById("mobile-articles-arrow");
  let mobileArticlesOpen = false;

  mobileArticlesToggle?.addEventListener("click", () => {
    mobileArticlesOpen = !mobileArticlesOpen;
    mobileArticlesSubmenu?.classList.toggle("hidden", !mobileArticlesOpen);
    if (mobileArticlesArrow) {
      mobileArticlesArrow.style.transform = mobileArticlesOpen ? "rotate(180deg)" : "";
    }
  });

  // Header avatar error handling
  document.getElementById("header-avatar")?.addEventListener("error", function (e) {
    const img = /** @type {HTMLImageElement} */ (e.target);
    const span = document.createElement("span");
    span.textContent = img.dataset.placeholder || "";
    span.className =
      "inline-flex h-8 w-8 items-center justify-center rounded-full bg-gray-200 text-sm font-bold text-gray-500 dark:bg-gray-700 dark:text-gray-300";
    img.replaceWith(span);
  });
</script>
