---
import type { Category } from "../types";

const base = import.meta.env.BASE_URL;

export interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<ul class="space-y-2">
  {categories.map(({ name, count }) => (
    <li>
      <a
        href={`${base}/blog/category/${name}`}
        class="flex items-center justify-between rounded-md px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-800"
      >
        <span class="text-gray-700 dark:text-gray-300">{name}</span>
        <span class="text-xs text-gray-400">({count} 篇)</span>
      </a>
    </li>
  ))}
</ul>
